# Copy to .env (never committed) and fill in.

# demo = built-in fictional records, no Discogs account needed (good for a first test)
# live = real Discogs data; each user links their own Discogs account in Settings
DISCOGS_MODE=demo

# Your Tailscale HTTPS address, e.g. https://vinyl-server.your-tailnet.ts.net (no trailing slash)
PUBLIC_URL=

# Optional: "Sign in with Discogs" button. Register an app at https://www.discogs.com/settings/developers
# (callback URL: <PUBLIC_URL>/api/discogs/oauth/callback). Without these, users paste a personal token.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Keep true when using the HTTPS Tailscale address. Set false only to test over plain http://localhost:7510
SECURE_COOKIES=true
